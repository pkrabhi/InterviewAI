{
  "expo": {
    "name": "Crackd",
    "slug": "InterviewAI",
    "version": "1.0.0",
    "scheme": "crackd",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.abhipkr.interviewai",
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Crackd — AI Interview Practice",
      "shortName": "Crackd",
      "description": "Practice real interviews with AI. Built for Indian IT job seekers.",
      "themeColor": "#6366F1",
      "backgroundColor": "#080B14"
    },
    "extra": {
      "eas": {
        "projectId": "65af80dc-7350-471e-a139-21aead1be6b7"
      }
    },
    "owner": "abhipkr",
    "plugins": [
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Crackd to use the microphone for voice answers.",
          "speechRecognitionPermission": "Allow Crackd to recognise your speech for voice answers."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366F1"
        }
      ]
    ]
  }
}
